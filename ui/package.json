{
  "name": "sealed-signals-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --mode live",
    "test": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "build:demo": "tsc --noEmit && vite build --mode mock",
    "dev:mock": "vite --host 0.0.0.0 --mode mock",
    "dev:live": "vite --host 0.0.0.0 --mode live --port 5175 --strictPort",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:scaffold": "playwright test --config playwright.scaffold.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-slider": "^1.3.6",
    "d3-geo": "^3.1.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}

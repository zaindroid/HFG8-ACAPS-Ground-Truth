# Development values only. Production secrets are generated by the platform (see app.yaml env:).
# The engine refuses to start without these two -- that is deliberate, not a bug.
COMMITMENT_SALT=dev-salt-not-for-production
PSEUDONYM_KEY=dev-pseudonym-key-not-for-production
APP_ENV=development
LOG_LEVEL=info
K_MIN=5
SEED_ON_START=true

# Optional. Live ACAPS API credential, from a free account at https://api.acaps.org
# Unset: the INFORM severity and humanitarian-access editions are read from the cache in
# data/acaps-api/, so the whole demo runs with no network. Set: the same shapes come from
# the live API. Either way /radar/status reports which one answered.
# The active risk list stays on the CSV export regardless -- the published risk-list
# endpoint is history and does not carry the R1000+ ids this demo uses.
# Put the real value in engine/.env, which is gitignored. Never here.
# ACAPS_API_TOKEN=

# Optional. Writes the expert card's follow-up questions from the risk record and the
# expert's profile, at pulse creation -- the analyst's side, never on the expert's phone
# (master prompt hard rule 4). Unset: the deterministic question bank answers, offline.
# Any OpenAI-shaped endpoint works. For OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Any ":free" model on OpenRouter costs nothing and is rate limited; the default above is
# the largest free one. If it refuses or throttles, google/gemma-4-31b-it:free is a
# smaller fallback. Malformed output is dropped and the deterministic bank answers, so a
# weak model degrades the questions rather than breaking the card.
# Put the real key in engine/.env, which is gitignored. Never here.
# LLM_API_KEY=


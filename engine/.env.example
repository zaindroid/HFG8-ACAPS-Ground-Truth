# Development values only. Production secrets are generated by the platform (see app.yaml env:).
# The engine refuses to start without these two -- that is deliberate, not a bug.
COMMITMENT_SALT=dev-salt-not-for-production
PSEUDONYM_KEY=dev-pseudonym-key-not-for-production
COMMITTEE_KEY=dev-committee-key-not-for-production
APP_ENV=development
LOG_LEVEL=info
K_MIN=5
SEED_ON_START=true

# Hardening flags (MASTER_PROMPT 6c). These are the defaults; set one to 0 to see the fallback.
# FF_ZK stays off: the Groth16 proof verifier is not implemented in this build (GET /api/zk/status).
FF_PQ=1
FF_BLIND=1
FF_ANCHOR=1
FF_ZK=0
